OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
FOOOCUS_HOST=http://127.0.0.1:7865
VRAM_TOTAL_MB=6144
VRAM_SAFETY_MARGIN_MB=512
MAX_RETRIES_ON_OOM=2

# ComfyUI (servidor HTTP) para o pipeline de video LTX-Video image-to-video.
# Suba o ComfyUI com `python main.py --listen` e aponte para ele aqui.
COMFYUI_HOST=http://127.0.0.1:8188

# Workflow exportado do ComfyUI em formato API (Workflow > Export (API Format)).
# Ver app/workflows/ltxv_i2v_api.json como referencia/ponto de partida.
COMFYUI_WORKFLOW_PATH=app/workflows/ltxv_i2v_api.json

# NOTA: largura/altura/length do video e denoise do KSampler NAO sao
# configuraveis por .env de proposito -- sao constantes rigidas em
# config.py (LTX_WIDTH/HEIGHT/LENGTH/DENOISE = 512/512/33/0.70), pensadas
# para caber em 6GB de VRAM. Mude direto em config.py se tiver uma GPU
# maior.

# --- ComfyUI (3D - Hunyuan3D 2.0, imagem -> malha) ---
# Mesmo servidor ComfyUI acima (COMFYUI_HOST). So precisa do checkpoint
# hunyuan3d-dit-v2_fp16.safetensors em ComfyUI/models/checkpoints/ -- ver
# app/workflows/hunyuan3d_i2mesh_api.json para o link de download.
COMFYUI_3D_WORKFLOW_PATH=app/workflows/hunyuan3d_i2mesh_api.json
COMFYUI_3D_CKPT_NAME=hunyuan3d-dit-v2_fp16.safetensors

# Conversao GLB -> FBX (opcional -- so usada se export_format="fbx" no
# POST /api/generate-3d). Deixe "blender" se o executavel estiver no PATH,
# ou aponte o caminho completo (ex. Windows:
# "C:\Program Files\Blender Foundation\Blender 4.2\blender.exe").
# Roblox Studio importa .glb tao bem quanto .fbx -- ver docstring de
# app/providers/mesh_converter.py antes de habilitar isso.
BLENDER_EXECUTABLE=blender
